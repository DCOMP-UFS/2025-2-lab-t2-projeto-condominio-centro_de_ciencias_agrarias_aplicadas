# Dockerfile simplificado para Laboratório 2
# Serve os arquivos HTML/CSS/imagens sem nginx.conf customizado
FROM nginx:alpine

# Copiar todos os arquivos do site
COPY laboratorio2/ /usr/share/nginx/html/

# Expor a porta 80
EXPOSE 80

# Comando para iniciar o Nginx com configuração padrão
CMD ["nginx", "-g", "daemon off;"]
